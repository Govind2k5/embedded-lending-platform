<?xml version="1.0" encoding="UTF-8"?>
<!--
    Maven build file for the Embedded Lending Platform.

    A few version overrides in here exist purely because this project was
    built and tested on JDK 25 (a very new JDK at the time), which exposed
    real compatibility gaps in Spring Boot 3.3.5's default dependency
    versions for annotation processing and mocking. See the inline comments
    on each override below, and the project's interview-prep notes, for the
    full story of what broke and why each fix was needed.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- spring-boot-starter-parent gives us a curated, tested set of
         dependency versions (dependencyManagement) and sensible default
         plugin configuration, so we don't have to pin a version number for
         every single Spring/Jackson/Hibernate/etc. dependency ourselves. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.5</version>
        <relativePath/>
    </parent>

    <groupId>com.lendingplatform</groupId>
    <artifactId>embedded-lending-platform</artifactId>
    <version>0.1.0</version>
    <name>embedded-lending-platform</name>
    <description>Simplified embedded digital lending marketplace (educational project)</description>

    <properties>
        <java.version>17</java.version>

        <!-- Lombok 1.18.46: the version spring-boot-starter-parent 3.3.5
             would otherwise pick (1.18.34) doesn't reliably hook into javac
             on very new JDKs (JDK 25 in particular) - annotation processing
             would silently produce NO generated code (no getters/setters/
             builders/constructors), failing compilation everywhere with
             "cannot find symbol" errors and no Lombok-related warning at all. -->
        <lombok.version>1.18.46</lombok.version>

        <!-- Mockito 5.23.0: newer than the version spring-boot-starter-parent
             pins, because older Mockito's bundled Byte Buddy version can't
             create mocks on JDK 25 ("Java 25 (69) is not supported by the
             current version of Byte Buddy"). -->
        <mockito.version>5.23.0</mockito.version>

        <!-- byte-buddy.version: spring-boot-dependencies pins byte-buddy to
             1.14.19 directly (not just via Mockito's own POM), and Maven's
             "nearest wins" dependency resolution means that pin wins even
             after bumping Mockito above. This explicit override forces the
             newer Byte Buddy (matching what Mockito 5.23.0 itself expects)
             to actually be used. -->
        <byte-buddy.version>1.17.7</byte-buddy.version>

        <springdoc.version>2.6.0</springdoc.version>
    </properties>

    <dependencies>
        <!-- Spring MVC + embedded Tomcat: @RestController, request/response handling. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Spring Data JPA + Hibernate: entities, repositories, transactions. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <!-- Bean Validation (@NotNull, @Positive, etc.) on request DTOs. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Spring Data Redis + Lettuce client: backs the lender-rules cache,
             idempotency keys, and rate-limit counters. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Postgres JDBC driver - only needed at runtime, not for compiling our code. -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Flyway: runs the SQL files in src/main/resources/db/migration on
             startup and owns the schema - Hibernate is configured
             (ddl-auto: validate, see application.yml) to only check the
             entities match, never to create/alter tables itself. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- springdoc-openapi: generates the OpenAPI spec + Swagger UI
             automatically from our @RestController classes and DTOs. -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <!-- Lombok: generates getters/setters/constructors/builders at
             compile time (see annotationProcessorPaths below for why this
             needs an explicit processor path on this project's JDK).
             `optional=true` keeps it out of the final runtime dependency
             tree of anything that depends on this project as a library. -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test dependencies below this line only. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: spins up real, throwaway Postgres/Redis Docker
             containers for integration tests, instead of H2 or a mocked
             Redis - see AbstractIntegrationTest. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!-- testcontainers-bom 1.21.4: newer than what an older
                 Testcontainers version would default to. An older
                 docker-java client (bundled with Testcontainers 1.20.2)
                 negotiated too old a Docker Engine API version for this
                 machine's Docker daemon ("client version 1.32 is too old,
                 minimum supported API version is 1.40") - bumping the BOM
                 pulls in a docker-java client that negotiates correctly. -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers-bom</artifactId>
                <version>1.21.4</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <!-- Lombok is a compile-time-only tool; it should never
                         be bundled into the runnable fat jar. -->
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Explicit processor path: on newer JDKs Lombok isn't reliably
                         auto-discovered off the plain classpath. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
